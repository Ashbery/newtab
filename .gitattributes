# Normalize text files (GitHub / cross-platform)
* text=auto eol=lf

# Explicit text types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary media — do not convert line endings (required for GitHub + browsers)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Archives / packs
*.zip   binary
*.streamDeckIconPack binary
*.sdIconPack binary

# Keep compiled models and the official Core's verified bytes unchanged.
*.moc3 binary
assets/vendor/cubism/live2dcubismcore.min.js -text
# Bundled SDK debug-format strings contain intentional spaces before newlines.
assets/vendor/cubism/companion-runtime.js whitespace=-blank-at-eol
